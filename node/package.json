{
  "name": "@tukupay/sdk",
  "version": "0.1.0-beta.1",
  "description": "Server-side Node.js library for the TukuPay API",
  "keywords": ["tukupay", "payments", "mpesa", "kenya", "fintech", "sdk"],
  "license": "MIT",
  "homepage": "https://tuku.money",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tukupay/tukupay-sdk.git",
    "directory": "node"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "generate": "openapi-typescript ../openapi/tukupay.json -o src/generated/api.ts --default-non-nullable=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "openapi-typescript": "^7.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
